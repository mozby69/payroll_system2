enum DisburseStatus {
  APPROVED
  AWAITING
  REJECTED
}

model main_disburse {
  mainDisburseID Int      @id @default(autoincrement())
  payrollCycle   String   @db.VarChar(50) @map("payroll_cycle")
  typeDisburse   String   @db.VarChar(50) @map("type_disburse")
  payrollPeriod  String   @db.VarChar(50) @map("payroll_period")
  createdAt      DateTime @map("created_at")
  status         DisburseStatus @default(AWAITING)
  totalDisburse  Decimal  @db.Decimal(10,2)

  empDisburses   emp_disburse[]   
}

model emp_disburse {
  disburseID      Int @id @default(autoincrement())

  empArchiveId    Int @map("emp_archive_id")
  empArchive      EmployeePayrollArchive @relation(fields: [empArchiveId], references: [id], onDelete: Cascade)

  mainDisburseId  Int @map("main_disburse_id")
  mainDisburse    main_disburse @relation(fields: [mainDisburseId], references: [mainDisburseID], onDelete: Cascade)

  @@unique([empArchiveId])
}


enum LeaveStatus {
  Active
  Completed
  Expected
}

enum LeaveName {
  Maternity
  Paternity
  Health
}

model SpecialLeaves {
    id Int @id
    leaveName            LeaveName
    start                DateTime? @db.Date
    end                  DateTime? @db.Date
    expectedStart        DateTime? @db.Date
    expectedEnd          DateTime? @db.Date
    status               LeaveStatus
    created_at            DateTime   @default(now())
    empCodeId            String

    employee            Employee  @relation(fields: [empCodeId], references: [EmpCode])        
    @@index([empCodeId])
  
}


model AttendanceCount {
  ID Int @id @default(autoincrement())
  Vacation Decimal @db.Decimal(10,2)
  Sick Decimal @db.Decimal(10,2)
  leave_convert Boolean @default(false)

  EmpCodeId String @unique @db.VarChar(20) @map("EmpCode_id")
  EmpCode Employee @relation(fields: [EmpCodeId], references: [EmpCode])

  @@map("myapp_attendancecount")
}


model PayrollWtaxOverride {
  id              Int      @id @default(autoincrement())

  PayCode         String   @db.VarChar(20)
  EmpCodeId       String   @db.VarChar(20)
  PayrollPeriod   String   @db.VarChar(50)

  computed_value  Decimal  @db.Decimal(12,2)
  edited_value    Decimal  @db.Decimal(12,2)

  created_at      DateTime @default(now())

  employeeSummary EmployeeSummary @relation(fields: [PayCode, EmpCodeId, PayrollPeriod],references: [PayCode, EmpCodeId, PayrollPeriod])

  @@index([PayCode, EmpCodeId, PayrollPeriod])
}